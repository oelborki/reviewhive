# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used for every per-agent call. Measured cost is $0.013 for a small
# single-file diff and $0.023 for a real six-file PR; it scales with diff size.
REVIEWHIVE_AGENT_MODEL=claude-haiku-4-5

# --- Review budget (safety net against runaway cost) ---
# Hard ceiling on prompt tokens sent to a single agent for one PR.
REVIEWHIVE_MAX_PROMPT_TOKENS=60000
# A single file contributing more than this many diff lines is truncated.
REVIEWHIVE_MAX_FILE_DIFF_LINES=400
# Maximum findings posted to a PR; the rest are summarized as a count.
REVIEWHIVE_MAX_POSTED_FINDINGS=15
# Findings below this confidence are dropped before ranking.
REVIEWHIVE_MIN_CONFIDENCE=0.35
# The lowest severity worth reporting: high, medium or low. `low` posts
# everything and is what this shipped with, so leaving it alone changes nothing.
#
# Raise it to medium when naming nits are drowning the findings that matter --
# without a floor, two LOW nits are enough to deny a clean verdict on a diff that
# has nothing wrong with it. Anything withheld is still counted in the summary,
# so raising this hides findings from the list but never from the reader.
REVIEWHIVE_MIN_SEVERITY=low

# Sampling temperature for the three reviewers, 0.0 to 1.0. Set to 0 rather than
# left at the API default: measured over five runs on one fixture, 0 halved the
# spread in findings per run and halved the number that came and went between
# runs, with no measured cost to recall. Raise it if you want the reviewers to
# range more widely and can tolerate a noisier re-review.
REVIEWHIVE_AGENT_TEMPERATURE=0.0

# --- Dedup ---
# The second deduplication pass: one call that judges the cross-lane duplicates
# the deterministic collapse cannot see. Measured at roughly $0.012 on a
# defect-dense diff, which is a real fraction of a review -- set it to false to
# skip the call, and the review is exactly what it was before the pass existed.
#
# If you copied this file before the pass shipped, your .env probably still pins
# this to false. Changing the default here does not change what your .env says.
REVIEWHIVE_ENABLE_LLM_MERGE=true
# How far apart two findings can sit and still be asked about. Wider than
# dedupe_line_tolerance because this pass reads both bodies rather than titles.
REVIEWHIVE_MERGE_LINE_WINDOW=8
# Cost guard. Pairs grow quadratically with findings on one file.
REVIEWHIVE_MERGE_MAX_PAIRS=24

# --- GitHub ---
# Prefixed rather than the bare GITHUB_TOKEN: GitHub Actions injects that name into
# every job, and the test suite must never acquire a real credential from CI.
# Fine-grained PAT scoped to the demo repo. It needs three permissions, not two:
#   Pull requests: read and write   post the review
#   Issues:        read and write   PR conversation comments are gated under Issues
#   Contents:      read             the .diff media type is repository content, and
#                                   without it the diff fetch 403s while every other
#                                   call still returns 200
# REVIEWHIVE_GITHUB_TOKEN=github_pat_...
# REVIEWHIVE_GITHUB_WEBHOOK_SECRET=
# Comma-separated owner/repo allowlist. Anything else is rejected outright, and an
# empty value denies everything — a public smee channel plus allow-by-default is an
# open budget.
# REVIEWHIVE_ALLOWED_REPOS=your-name/reviewhive-demo
# Re-review when a PR is pushed to. Off because `synchronize` fires once per push
# with a fresh head sha, so five quick commits are five reviews and five bills.
# REVIEWHIVE_REVIEW_ON_SYNCHRONIZE=false

# The literal token that summons the bot in a comment. Deliberately not an @name:
# `ReviewHive` is a real GitHub account belonging to someone unconnected to this
# project, so an @-form links to a stranger's profile and pings them the moment
# the repository is public. A leading slash cannot be a GitHub username, so it
# can never collide with an account registered later.
#
# If you copied this file before that change, your .env probably still pins the
# @ form. Changing the default here does not change what your .env says.
# REVIEWHIVE_MENTION_HANDLE=/reviewhive
# Cap on mention responses per pull request per hour. Anyone who can comment can
# spend money; the self-login guard only stops the bot answering itself.
# REVIEWHIVE_MAX_MENTION_RESPONSES_PER_HOUR=10

# --- Logging ---
# Applies to this project's loggers only; dependencies stay at WARNING whatever
# this says, so DEBUG gets you more of our own reasoning rather than an httpx
# line per HTTP request. INFO is where the webhook explains why it ignored a
# delivery, which is its most common behaviour.
# REVIEWHIVE_LOG_LEVEL=INFO

# --- Database ---
# Optional. Unset means reviews are not persisted and the CLI runs exactly as
# before — useful when iterating on prompts with no Postgres running.
# The asyncpg driver is required; a bare postgresql:// URL is rejected at load.
# Start the database with: docker compose up -d db && alembic upgrade head
# REVIEWHIVE_DATABASE_URL=postgresql+asyncpg://reviewhive:reviewhive@localhost:5432/reviewhive

# Host port for the compose Postgres. Read by docker compose, not by the app.
# Set this if something else already holds 5432, and match it in the URLs above
# and below.
# POSTGRES_PORT=5433

# Used only by `pytest -m db`. Must name a database called reviewhive_test; the
# fixtures refuse anything else so a typo cannot truncate development data.
# REVIEWHIVE_TEST_DATABASE_URL=postgresql+asyncpg://reviewhive:reviewhive@localhost:5432/reviewhive_test
