+
+
+SORT_DIRECTIONS = {"ASC", "DESC"}
+
+
+def list_tasks_sorted(owner: str, order: str) -> list[sqlite3.Row]:
+    direction = order.strip().upper()
+    if direction not in SORT_DIRECTIONS:
+        raise ValueError(f"unsupported sort direction: {order!r}")
+    with connect() as conn:
+        return conn.execute(
+            "SELECT id, title, owner, done FROM tasks "
+            f"WHERE owner = ? ORDER BY id {direction}",
+            (owner,),
+        ).fetchall()
+
+
+def search_tasks(owner: str, term: str) -> list[sqlite3.Row]:
+    with connect() as conn:
+        return conn.execute(
+            f"SELECT id, title, owner, done FROM tasks "
+            f"WHERE owner = '{owner}' AND title LIKE '%{term}%'"
+        ).fetchall()
