+SORTED_QUERIES = {
+    "ASC": (
+        "SELECT id, title, owner, done, priority FROM tasks "
+        "WHERE owner = ? ORDER BY priority ASC"
+    ),
+    "DESC": (
+        "SELECT id, title, owner, done, priority FROM tasks "
+        "WHERE owner = ? ORDER BY priority DESC"
+    ),
+}
