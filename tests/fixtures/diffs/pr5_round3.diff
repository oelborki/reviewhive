@@ -0,0 +1,57 @@
+"""Tests for CSV parsing and the priority vocabulary."""
+
+from __future__ import annotations
+
+import pytest
+
+from app.models import level_index, level_name
+from app.priority import parse_rows
+
+
+def test_reads_title_and_priority() -> None:
+    parsed = parse_rows("write tests,high")
+
+    assert parsed.rows == [("write tests", 2)]
+    assert parsed.skipped == 0
+
+
+def test_blank_lines_are_not_counted_as_skipped() -> None:
+    parsed = parse_rows("a,low\n\n\nb,high")
+
+    assert len(parsed.rows) == 2
+    assert parsed.skipped == 0
+
+
+@pytest.mark.parametrize("blob", ["only-one-column", "a,b,c", ",normal"])
+def test_malformed_records_are_counted_not_dropped_silently(blob: str) -> None:
+    parsed = parse_rows(blob)
+
+    assert parsed.rows == []
+    assert parsed.skipped == 1
+
+
+def test_an_unknown_priority_falls_back_to_the_default() -> None:
+    parsed = parse_rows("a,nonsense")
+
+    assert parsed.rows == [("a", level_index("normal"))]
+
+
+def test_long_titles_are_truncated_to_the_column_limit() -> None:
+    parsed = parse_rows(f"{'x' * 300},low")
+
+    assert len(parsed.rows[0][0]) == 200
+
+
+def test_quoted_commas_stay_inside_the_title() -> None:
+    parsed = parse_rows('"buy milk, eggs",normal')
+
+    assert parsed.rows[0][0] == "buy milk, eggs"
+
+
+@pytest.mark.parametrize("name", ["low", "normal", "high", "urgent"])
+def test_level_names_round_trip(name: str) -> None:
+    assert level_name(level_index(name)) == name
+
+
+def test_an_out_of_range_index_reads_as_the_default() -> None:
+    assert level_name(99) == "normal"
