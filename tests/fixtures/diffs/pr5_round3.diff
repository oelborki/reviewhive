--- /dev/null
+++ b/app/priority.py
@@ -0,0 +1,90 @@
+"""Bulk import of tasks from a CSV blob."""
+
+from __future__ import annotations
+
+import csv
+import io
+from dataclasses import dataclass
+
+from app import db
+from app.models import level_index
+
+MAX_TITLE_LENGTH = 200
+COLUMNS_PER_ROW = 2
+
+
+@dataclass(frozen=True)
+class ParsedRows:
+    """The result of reading a blob: what was understood, and how much was not."""
+
+    rows: list[tuple[str, int]]
+    skipped: int
+
+
+def parse_rows(blob: str) -> ParsedRows:
+    """Read ``title,priority`` records out of a CSV blob.
+
+    Pure: no database access, so the parsing rules can be tested on their own.
+    A record is skipped when it has the wrong number of columns or an empty
+    title, and the count is returned rather than discarded so the caller can
+    report it.
+
+    Args:
+        blob: The uploaded text, one record per line.
+
+    Returns:
+        The rows that parsed, as ``(title, priority index)``, and a count of
+        those that did not.
+    """
+    rows: list[tuple[str, int]] = []
+    skipped = 0
+
+    for record in csv.reader(io.StringIO(blob)):
+        if not record or not any(field.strip() for field in record):
+            continue
+        if len(record) != COLUMNS_PER_ROW:
+            skipped += 1
+            continue
+
+        title = record[0].strip()
+        if not title:
+            skipped += 1
+            continue
+
+        rows.append((title[:MAX_TITLE_LENGTH], level_index(record[1])))
+
+    return ParsedRows(rows=rows, skipped=skipped)
+
+
+def bulk_import(owner: str, blob: str) -> tuple[list[dict], int]:
+    """Parse a blob and store its tasks for ``owner``.
+
+    The caller is responsible for checking that the requester may write to
+    ``owner`` -- this function does no authorisation of its own.
+
+    Every row is written through one connection, so the import either commits
+    as a whole or leaves nothing behind.
+
+    Returns:
+        The stored tasks, and the number of records that could not be read.
+    """
+    parsed = parse_rows(blob)
+    stored: list[dict] = []
+
+    with db.connect() as conn:
+        for title, priority_index in parsed.rows:
+            cursor = conn.execute(
+                "INSERT INTO tasks (title, owner, priority) VALUES (?, ?, ?)",
+                (title, owner, priority_index),
+            )
+            stored.append(
+                {
+                    "id": cursor.lastrowid,
+                    "title": title,
+                    "owner": owner,
+                    "done": 0,
+                    "priority": priority_index,
+                }
+            )
+
+    return stored, parsed.skipped
