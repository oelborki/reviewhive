+"""Tests for who may act on whose tasks."""
+
+from __future__ import annotations
+
+import pytest
+
+from app.auth import can_access
+
+
+def test_an_owner_may_reach_their_own_tasks() -> None:
+    assert can_access("ana", "ana") is True
+
+
+def test_a_stranger_may_not() -> None:
+    assert can_access("ana", "bo") is False
+
+
+def test_an_admin_may_reach_anyone() -> None:
+    assert can_access("ana", "bo", is_admin=True) is True
+
+
+@pytest.mark.parametrize("owner, caller", [("", "ana"), ("ana", ""), ("", "")])
+def test_a_missing_identity_is_refused_even_for_an_admin(owner: str, caller: str) -> None:
+    assert can_access(owner, caller, is_admin=True) is False
