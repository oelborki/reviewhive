 from __future__ import annotations
 
+from collections.abc import Mapping
+from typing import Any
+
 from pydantic import BaseModel, Field
 
+# Priority is a level name at the API boundary and an index in the database. The
+# vocabulary lives here so that both sides agree on it.
+LEVELS = ["low", "normal", "high", "urgent"]
+DEFAULT_LEVEL = "normal"
+
+
+def level_index(name: str) -> int:
+    """Map a level name to its stored index, falling back to the default."""
+    cleaned = name.strip().lower()
+    if cleaned not in LEVELS:
+        return LEVELS.index(DEFAULT_LEVEL)
+    return LEVELS.index(cleaned)
+
+
+def level_name(index: int) -> str:
+    """Map a stored index back to its level name."""
+    if 0 <= index < len(LEVELS):
+        return LEVELS[index]
+    return DEFAULT_LEVEL
+
 
 class TaskIn(BaseModel):
     title: str = Field(min_length=1, max_length=200)
+    priority: str = DEFAULT_LEVEL
 
 
 class TaskOut(BaseModel):
@@ -14,3 +38,31 @@ class TaskOut(BaseModel):
     title: str
     owner: str
     done: bool
+    # A level name, matching TaskIn.priority. The database stores the index.
+    priority: str = DEFAULT_LEVEL
+
+    @classmethod
+    def from_row(cls, row: Mapping[str, Any]) -> TaskOut:
+        """Build a response from a database row, naming the stored priority.
+
+        Takes any mapping rather than ``sqlite3.Row`` so a caller holding rows it
+        has just written does not have to read them back to answer with them.
+        """
+        return cls(
+            id=row["id"],
+            title=row["title"],
+            owner=row["owner"],
+            done=bool(row["done"]),
+            priority=level_name(row["priority"]),
+        )
