+def list_tasks_sorted(owner: str, order: str) -> list[sqlite3.Row]:
+    """List one owner's tasks by priority.
+
+    Args:
+        owner: The account the tasks belong to.
+        order: ``ASC`` or ``DESC``, case-insensitive.
+
+    Raises:
+        ValueError: If ``order`` is not a supported direction.
+    """
+    query = SORTED_QUERIES.get(order.strip().upper())
+    if query is None:
+        # The rejected value is not echoed back: it came from the caller and has
+        # no place in a message that may reach a log or another user.
+        raise ValueError("unsupported sort direction")
+    with connect() as conn:
+        return conn.execute(query, (owner,)).fetchall()
