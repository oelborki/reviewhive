+"""Who may act on whose tasks."""
+
+from __future__ import annotations
+
+
+def can_access(owner: str, requester: str, is_admin: bool = False) -> bool:
+    """Whether ``requester`` may read or modify tasks belonging to ``owner``.
+
+    Args:
+        owner: The account the tasks belong to.
+        requester: The authenticated caller. Empty means unauthenticated.
+        is_admin: Whether the caller holds the administrator role.
+
+    Returns:
+        True if the caller owns the tasks or is an administrator.
+    """
+    if not requester or not owner:
+        return False
+    return requester == owner or is_admin
