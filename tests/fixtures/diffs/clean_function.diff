+++ b/tests/test_formatting.py
@@ -0,0 +1,26 @@
+"""Tests for the task count summary."""
+
+from __future__ import annotations
+
+import pytest
+
+from app.formatting import summarize_counts
+
+
+def test_reports_both_counts() -> None:
+    assert summarize_counts(3, 1) == "3 done, 1 pending"
+
+
+def test_an_empty_list_reads_as_empty() -> None:
+    assert summarize_counts(0, 0) == "Nothing here yet."
+
+
+def test_zero_in_one_column_is_still_reported() -> None:
+    assert summarize_counts(0, 2) == "0 done, 2 pending"
+    assert summarize_counts(2, 0) == "2 done, 0 pending"
+
+
+@pytest.mark.parametrize("done, pending", [(-1, 0), (0, -1)])
+def test_negative_counts_are_rejected(done: int, pending: int) -> None:
+    with pytest.raises(ValueError, match="cannot be negative"):
+        summarize_counts(done, pending)
