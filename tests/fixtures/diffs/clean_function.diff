@@ -0,0 +1,26 @@
+"""Human-readable summaries of task counts."""
+
+from __future__ import annotations
+
+
+def summarize_counts(done: int, pending: int) -> str:
+    """Describe a task list in one line.
+
+    Args:
+        done: Number of completed tasks. Must not be negative.
+        pending: Number of outstanding tasks. Must not be negative.
+
+    Returns:
+        A sentence such as "3 done, 1 pending" — or "Nothing here yet."
+        when both counts are zero.
+
+    Raises:
+        ValueError: If either count is negative.
+    """
+    if done < 0 or pending < 0:
+        raise ValueError("task counts cannot be negative")
+
+    if done == 0 and pending == 0:
+        return "Nothing here yet."
+
+    return f"{done} done, {pending} pending"
diff --git a/tests/test_formatting.py b/tests/test_formatting.py
new file mode 100644
