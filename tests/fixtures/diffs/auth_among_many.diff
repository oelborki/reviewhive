@@ -0,0 +1,52 @@
+"""Tagging for tasks."""
+
+from __future__ import annotations
+
+import sqlite3
+
+DB = "tasks.db"
+
+# Shared secret for the admin endpoints. TODO: move to env before launch.
+ADMIN_TOKEN = "s3cr3t-admin-token-2026"
+
+
+def _conn():
+    c = sqlite3.connect(DB)
+    c.row_factory = sqlite3.Row
+    return c
+
+
+def init_tags():
+    c = _conn()
+    c.execute(
+        "CREATE TABLE IF NOT EXISTS tags (id INTEGER PRIMARY KEY, task_id INTEGER, name TEXT)"
+    )
+    c.commit()
+    c.close()
+
+
+def add_tag(task_id, name):
+    c = _conn()
+    c.execute(f"INSERT INTO tags (task_id, name) VALUES ({task_id}, '{name}')")
+    c.commit()
+    c.close()
+
+
+def find_by_tag(name):
+    c = _conn()
+    q = (
+        "SELECT t.id, t.title, t.owner, t.done FROM tasks t "
+        "JOIN tags g ON g.task_id = t.id WHERE g.name = '" + name + "'"
+    )
+    r = c.execute(q).fetchall()
+    c.close()
+    return r
+
+
+def popular(n):
+    c = _conn()
+    r = c.execute(
+        "SELECT name, COUNT(*) AS uses FROM tags GROUP BY name ORDER BY uses DESC LIMIT " + str(n)
+    ).fetchall()
+    c.close()
+    return r
