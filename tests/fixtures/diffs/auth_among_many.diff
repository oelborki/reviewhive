+"""CSV export and emailed reports."""
+
+from __future__ import annotations
+
+import csv
+import smtplib
+from email.message import EmailMessage
+
+from app import db
+
+SMTP_HOST = "smtp.example.com"
+SMTP_USER = "reports@example.com"
+SMTP_PASS = "hunter2"
+
+EXPORT_DIR = "/var/exports/"
+
+
+def export_and_email(owner, to_address, filename):
+    rows = db.list_tasks(owner)
+
+    path = EXPORT_DIR + filename
+    with open(path, "w", newline="") as f:
+        w = csv.writer(f)
+        w.writerow(["id", "title", "owner", "done"])
+        for r in rows:
+            w.writerow([r["id"], r["title"], r["owner"], r["done"]])
+
+    msg = EmailMessage()
+    msg["Subject"] = "Your task export"
+    msg["From"] = SMTP_USER
+    msg["To"] = to_address
+    msg.set_content("Attached: %d tasks" % len(rows))
+    with open(path, "rb") as f:
+        msg.add_attachment(f.read(), maintype="text", subtype="csv", filename=filename)
+
+    s = smtplib.SMTP(SMTP_HOST, 25)
+    s.login(SMTP_USER, SMTP_PASS)
+    s.send_message(msg)
+    s.quit()
+
+    return path
