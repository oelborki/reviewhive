+def require_api_key(x_api_key: str = Header(default="")) -> None:
+    """Digests are sent by the scheduler, not by end users."""
+    expected = os.environ.get("NOTIFY_API_KEY", "")
+    if not expected or not hmac.compare_digest(x_api_key, expected):
+        raise HTTPException(status_code=401, detail="unauthorized")
+
+
+@app.post("/notify/{owner}", dependencies=[Depends(require_api_key)])
+def notify_owner(owner: str) -> dict[str, int]:
+    return {"status": notify.send_digest(owner)}
