@@ -0,0 +1,60 @@
+"""Reporting."""
+
+from __future__ import annotations
+
+import sqlite3
+import smtplib
+from email.message import EmailMessage
+
+DB_PATH = "tasks.db"
+
+SMTP_HOST = "smtp.example.com"
+SMTP_USER = "reports@example.com"
+SMTP_PASS = "hunter2"
+
+
+def build_and_send_report(owner, email, fmt="text", include_done=True, send=True):
+    conn = sqlite3.connect(DB_PATH)
+    conn.row_factory = sqlite3.Row
+    q = "SELECT id, title, owner, done FROM tasks WHERE owner = '" + owner + "'"
+    if not include_done:
+        q = q + " AND done = 0"
+    rows = conn.execute(q).fetchall()
+    conn.close()
+
+    d = {"total": len(rows), "done": 0, "open": 0}
+    for r in rows:
+        if r["done"]:
+            d["done"] = d["done"] + 1
+        else:
+            d["open"] = d["open"] + 1
+
+    if fmt == "text":
+        body = "Report for " + owner + "\n"
+        body = body + "Total: " + str(d["total"]) + "\n"
+        body = body + "Done: " + str(d["done"]) + "\n"
+        body = body + "Open: " + str(d["open"]) + "\n"
+        for r in rows:
+            body = body + "- [" + ("x" if r["done"] else " ") + "] " + r["title"] + "\n"
+    elif fmt == "html":
+        body = "<h1>Report for " + owner + "</h1>"
+        body = body + "<p>Total: " + str(d["total"]) + "</p>"
+        body = body + "<ul>"
+        for r in rows:
+            body = body + "<li>" + r["title"] + "</li>"
+        body = body + "</ul>"
+    else:
+        body = str(d)
+
+    if send:
+        msg = EmailMessage()
+        msg["Subject"] = "Your task report"
+        msg["From"] = SMTP_USER
+        msg["To"] = email
+        msg.set_content(body)
+        s = smtplib.SMTP(SMTP_HOST)
+        s.login(SMTP_USER, SMTP_PASS)
+        s.send_message(msg)
+        s.quit()
+
+    return body
