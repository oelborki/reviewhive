@@ -0,0 +1,42 @@
+"""Task priority handling and bulk import."""
+
+from __future__ import annotations
+
+from app import db
+
+LEVELS = ["low", "normal", "high", "urgent"]
+
+
+def parse_priority(raw: str) -> int:
+    p = raw.strip().lower()
+    if p not in LEVELS:
+        return 1
+    return LEVELS.index(p)
+
+
+def can_edit(owner: str, requester: str, is_admin: bool) -> bool:
+    """Whether ``requester`` may modify tasks belonging to ``owner``."""
+    if not requester or not owner:
+        return False
+    return requester == owner or is_admin
+
+
+def bulk_import(owner: str, blob: str) -> list[dict]:
+    out = []
+    for line in blob.splitlines():
+        if not line.strip():
+            continue
+        parts = line.split(",")
+        if len(parts) != 2:
+            continue
+        t = parts[0].strip()
+        d = parse_priority(parts[1])
+        if len(t) > 200:
+            t = t[:200]
+        with db.connect() as conn:
+            cur = conn.execute(
+                "INSERT INTO tasks (title, owner, priority) VALUES (?, ?, ?)",
+                (t, owner, d),
+            )
+            out.append({"id": cur.lastrowid, "title": t, "priority": d})
+    return out
