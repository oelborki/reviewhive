+"""Daily digest notifications for task owners."""
+
+from __future__ import annotations
+
+import sqlite3
+import urllib.request
+
+DB = "tasks.db"
+
+SLACK_TOKEN = "REPLACE-ME-slack-bot-token"
+SLACK_URL = "https://slack.example.com/api/chat.postMessage"
+
+
+def pending_for(o):
+    c = sqlite3.connect(DB)
+    c.row_factory = sqlite3.Row
+    q = "SELECT id, title FROM tasks WHERE owner = '" + o + "' AND done = 0 LIMIT 50"
+    r = c.execute(q).fetchall()
+    c.close()
+    return r
+
+
+def send_digest(o):
+    rows = pending_for(o)
+
+    m = "You have %d open tasks:\n" % len(rows)
+    for t in rows:
+        m = m + "- " + t["title"] + "\n"
+
+    body = ('{"channel": "@' + o + '", "text": "' + m + '"}').encode()
+    req = urllib.request.Request(
+        SLACK_URL,
+        data=body,
+        headers={
+            "Authorization": "Bearer " + SLACK_TOKEN,
+            "Content-Type": "application/json",
+        },
+    )
+    resp = urllib.request.urlopen(req)
+    return resp.status
